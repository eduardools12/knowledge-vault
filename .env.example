# =============================================================================
# Knowledge Vault — environment variables
# =============================================================================
# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Dashboard > Project Settings > API).
#
# `.env.local` is git-ignored. Never commit real keys.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (required)
# -----------------------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The `anon` / publishable key. Safe to expose in the browser: it carries no
# privileges of its own and every query it makes is constrained by Row Level
# Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Application (recommended)
# -----------------------------------------------------------------------------
# Public origin of the app, used to build the links inside confirmation and
# password-reset emails. Optional locally (the Host header is used instead),
# but REQUIRED in production so those links point at the right domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Server-only secrets (not needed for the app to run; needed for AI features)
# -----------------------------------------------------------------------------
# Bypasses Row Level Security. Only used by src/lib/supabase/service.ts, the
# embedding worker's client (Etapa 11) — it needs to read across every user's
# content to process the shared job queue. Must NEVER be prefixed with
# NEXT_PUBLIC_ and must never reach the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# Only read by src/lib/ai/anthropic-provider.ts, the one file in the app that
# talks to the completion model (see docs/ai.md). Powers "Sugerir com IA" on
# the Inbox (Etapa 10). Never prefixed with NEXT_PUBLIC_ — every AI call
# happens on the server.
# ANTHROPIC_API_KEY=

# Only read by src/lib/embeddings/openai-provider.ts. The Anthropic API has no
# embeddings endpoint, so semantic search (Etapa 11) depends on this separate
# vendor — see docs/ai.md. Without it, indexing jobs fail gracefully and
# hybrid search silently falls back to keyword-only.
# OPENAI_API_KEY=

# Shared secret required by the embedding worker route
# (src/app/api/jobs/embeddings). Set the same value here and on the Vercel
# Cron job configuration — Vercel sends it as `Authorization: Bearer <value>`.
# Without it, the route refuses every request rather than running unprotected.
# CRON_SECRET=
